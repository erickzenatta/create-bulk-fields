// =====================================================================
// zen_createFieldsFromJson
// Creates sections and fields in a Zoho CRM layout from a JSON.
// Standalone function, return type: string
// Argument: jsonText (string) = the JSON generated by the prompt
//
// What it does:
//  - Skips fields whose label already exists in the module (safe to rerun)
//  - Creates the section if it doesn't exist, or adds fields to the existing one
//  - Sends at most 5 fields per call (API limit)
//  - Processes formula and rollup_summary last, since they depend on other fields
//  - Only creates multiselectlookup if allow_multiselectlookup = true
//
// Connection "crm" needs scopes:
//   ZohoCRM.settings.fields.ALL, ZohoCRM.settings.layouts.ALL
// Non-US data centers: replace zohoapis.com with the correct domain
// =====================================================================
string standalone.zen_createFieldsFromJson(string jsonText)
{
	inputConfig = jsonText.toMap();
	info "[CONFIG] Parsed config: " + inputConfig;

	moduleName = inputConfig.get("module");
	layoutId = inputConfig.get("layout_id");
	info "[CONFIG] Module: " + moduleName + " | Layout ID: " + layoutId;

	allowMultiSelectLookup = false;
	if(inputConfig.get("allow_multiselectlookup") != null)
	{
		if(inputConfig.get("allow_multiselectlookup").toString() == "true")
		{
			allowMultiSelectLookup = true;
		}
	}

	layoutApiUrl = "https://www.zohoapis.com/crm/v8/settings/layouts/" + layoutId + "?module=" + moduleName;
	info "[CONFIG] Allow multiselectlookup: " + allowMultiSelectLookup;

	// Existing field labels, used to skip duplicates
	existingFieldsResponse = invokeurl
	[
		url :"https://www.zohoapis.com/crm/v8/settings/fields?module=" + moduleName
		type :GET
		connection:"crm"
	];
	info "[FIELDS] Existing fields response received";
	existingFieldLabels = List();
	for each existingField in existingFieldsResponse.get("fields")
	{
		existingFieldLabels.add(existingField.get("field_label").toLowerCase());
	}

	info "[FIELDS] Existing field count: " + existingFieldLabels.size();

	deferredFieldTypes = {"formula","rollup_summary"};
	processingPasses = {"simple","deferred"};
	resultReport = List();

	// Section map { "Section name" : "section_id" }, refreshed from the layout when needed
	sectionIdsByName = Map();
	refreshSectionIds = true;

	for each currentPass in processingPasses
	{
		info "[PASS] Starting pass: " + currentPass;
		for each sectionConfig in inputConfig.get("sections")
		{
			sectionName = sectionConfig.get("name");
			fieldsToCreate = List();

			for each fieldConfig in sectionConfig.get("fields")
			{
				fieldLabel = fieldConfig.get("field_label");
				fieldDataType = fieldConfig.get("data_type");

				isDeferredType = false;
				if(deferredFieldTypes.contains(fieldDataType))
				{
					isDeferredType = true;
				}

				isInCurrentPass = false;
				if(currentPass == "simple" && isDeferredType == false)
				{
					isInCurrentPass = true;
				}
				if(currentPass == "deferred" && isDeferredType == true)
				{
					isInCurrentPass = true;
				}

				if(isInCurrentPass)
				{
					if(existingFieldLabels.contains(fieldLabel.toLowerCase()))
					{
						resultReport.add("SKIP (already exists): " + fieldLabel);
					}
					else if(fieldDataType == "multiselectlookup" && allowMultiSelectLookup == false)
					{
						resultReport.add("SKIP (multiselectlookup not allowed): " + fieldLabel);
					}
					else
					{
						fieldsToCreate.add(fieldConfig);
					}
				}
			}

			// Split into chunks of 5 (API limit per call)
			fieldBatches = List();
			currentBatch = List();
			for each fieldToBatch in fieldsToCreate
			{
				currentBatch.add(fieldToBatch);
				if(currentBatch.size() == 5)
				{
					fieldBatches.add(currentBatch);
					currentBatch = List();
				}
			}
			if(currentBatch.size() > 0)
			{
				fieldBatches.add(currentBatch);
			}
			info "[SECTION] " + sectionName + " | Pass: " + currentPass + " | Fields to create: " + fieldsToCreate.size() + " | Batches: " + fieldBatches.size();

			for each fieldBatch in fieldBatches
			{
				// Refresh section IDs from the layout (first run, or after creating a new section)
				if(refreshSectionIds)
				{
					layoutResponse = invokeurl
					[
						url :layoutApiUrl
						type :GET
						connection:"crm"
					];
					sectionIdsByName = Map();
					layoutList = layoutResponse.get("layouts");
					layoutData = layoutList.get(0);
					layoutSections = layoutData.get("sections");
					for each layoutSection in layoutSections
					{
						sectionIdsByName.put(layoutSection.get("display_label"),layoutSection.get("id"));
					}
					refreshSectionIds = false;
					info "[SECTIONS] Section IDs in layout: " + sectionIdsByName;
				}

				sectionPayload = Map();
				isNewSection = true;
				if(sectionIdsByName.containsKey(sectionName))
				{
					isNewSection = false;
				}

				if(isNewSection)
				{
					sectionPayload.put("display_label",sectionName);
				}
				else
				{
					sectionPayload.put("id",sectionIdsByName.get(sectionName));
				}
				sectionPayload.put("fields",fieldBatch);

				sectionPayloadList = List();
				sectionPayloadList.add(sectionPayload);

				layoutPayload = Map();
				layoutPayload.put("sections",sectionPayloadList);

				layoutPayloadList = List();
				layoutPayloadList.add(layoutPayload);

				requestBody = Map();
				requestBody.put("layouts",layoutPayloadList);

				info "[REQUEST] Section: " + sectionName + " | New section: " + isNewSection + " | Body: " + requestBody;

				requestHeaders = Map();
				requestHeaders.put("Content-Type","application/json");

				patchResponse = invokeurl
				[
					url :layoutApiUrl
					type :PATCH
					parameters:requestBody.toString()
					headers:requestHeaders
					connection:"crm"
				];
				info "[RESPONSE] Section: " + sectionName + " | Response: " + patchResponse;

				batchFieldLabels = List();
				for each batchField in fieldBatch
				{
					batchFieldLabels.add(batchField.get("field_label"));
				}

				responseCode = "ERROR";
				responseLayouts = patchResponse.get("layouts");
				if(responseLayouts != null)
				{
					if(responseLayouts.size() > 0)
					{
						responseCode = responseLayouts.get(0).get("code");
					}
				}

				if(responseCode == "SUCCESS")
				{
					for each createdLabel in batchFieldLabels
					{
						existingFieldLabels.add(createdLabel.toLowerCase());
					}
					resultReport.add("OK [" + sectionName + "]: " + batchFieldLabels.toString(", "));
					if(isNewSection)
					{
						refreshSectionIds = true;
					}
				}
				else
				{
					resultReport.add("ERROR [" + sectionName + "]: " + batchFieldLabels.toString(", ") + " | " + patchResponse);
				}
			}
		}
	}
	info "[DONE] Result report:\n" + resultReport.toString("\n");
	return resultReport.toString("\n");
}
